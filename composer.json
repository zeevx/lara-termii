{
    "name": "zeevx/lara-termii",
    "description": "A modern Laravel package for the Termii messaging & OTP API - https://www.termii.com",
    "keywords": [
        "zeevx",
        "lara-termii",
        "termii",
        "laravel",
        "sms",
        "otp",
        "whatsapp",
        "voice"
    ],
    "homepage": "https://github.com/zeevx/lara-termii",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Paul Adams",
            "email": "adamsohiani@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^1.23|^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Zeevx\\LaraTermii\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeevx\\LaraTermii\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zeevx\\LaraTermii\\LaraTermiiServiceProvider"
            ],
            "aliases": {
                "LaraTermii": "Zeevx\\LaraTermii\\LaraTermiiFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
